---
interface Props {
  variant?: "dark" | "light";
}
const { variant = "dark" } = Astro.props;
const textColor = variant === "light" ? "text-white" : "text-navy";
---

<span class={`inline-flex items-center gap-2 font-extrabold ${textColor}`}>
  <span
    class="bg-accent-gradient inline-flex h-8 w-8 items-center justify-center rounded-full text-white"
  >
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
      <path
        d="M12 5v14M5 12h14"
        stroke="currentColor"
        stroke-width="3"
        stroke-linecap="round"
      ></path>
    </svg>
  </span>
  <span class="leading-tight">
    <span class="block text-sm tracking-wide">BLUMENKRON</span>
    <span class="block text-[10px] font-medium tracking-[0.2em] opacity-80"
      >by MEDICAL BK</span
    >
  </span>
</span>
