---
interface Props {
  // El logo actual ya es un wordmark completo (texto + marca en un solo
  // archivo) con degradado de color propio, por lo que se ve bien tanto en
  // fondo claro (Header) como oscuro (Footer) sin variante. Se conserva la
  // prop para no tener que tocar cada lugar que ya pasa variant="light|dark".
  variant?: "dark" | "light";
}
---

<img
  src="/logo.png"
  alt="Medical BK"
  width="992"
  height="177"
  class="h-8 w-auto sm:h-9"
/>
