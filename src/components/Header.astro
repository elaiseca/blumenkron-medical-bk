---
import Logo from "./Logo.astro";

const nav = [
  { href: "/", label: "Inicio" },
  { href: "/membresias", label: "Membresías" },
  { href: "/red-medica", label: "Red Médica" },
  { href: "/nosotros", label: "Nosotros" },
  { href: "/cotizador", label: "Cotizador" },
  { href: "/faq", label: "FAQ" },
  { href: "/contacto", label: "Contacto" },
] as const;

const currentPath = Astro.url.pathname;
---

<header
  class="sticky top-0 z-50 border-b border-slate-200/60 bg-white/85 backdrop-blur-md"
>
  <div
    class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6"
  >
    <a href="/" class="shrink-0">
      <Logo variant="dark" />
    </a>

    <nav class="hidden items-center gap-1 lg:flex">
      {
        nav.map((item) => {
          const active =
            item.href === "/"
              ? currentPath === "/"
              : currentPath.startsWith(item.href);
          return (
            <a
              href={item.href}
              class={`rounded-md px-3 py-2 text-sm font-medium transition hover:bg-brand-soft hover:text-brand-blue ${
                active ? "bg-brand-soft text-brand-blue" : "text-navy/75"
              }`}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="hidden lg:block">
      <a
        href="/cotizador"
        class="bg-accent-gradient shadow-brand rounded-md px-4 py-2 text-sm font-semibold text-white"
      >
        Cotizar ahora
      </a>
    </div>

    <button
      id="menu-toggle"
      class="lg:hidden"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg
        id="icon-menu"
        viewBox="0 0 24 24"
        width="24"
        height="24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round"></path>
      </svg>
      <svg
        id="icon-close"
        class="hidden"
        viewBox="0 0 24 24"
        width="24"
        height="24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-slate-200 bg-white lg:hidden">
    <div class="mx-auto flex max-w-7xl flex-col gap-1 px-4 py-3">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="rounded-md px-3 py-2 text-sm font-medium text-navy/80 hover:bg-brand-soft"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/cotizador"
        class="bg-accent-gradient mt-2 rounded-md px-4 py-2 text-center text-sm font-semibold text-white"
      >
        Cotizar ahora
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconMenu = document.getElementById("icon-menu");
  const iconClose = document.getElementById("icon-close");

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(isOpen));
    iconMenu?.classList.toggle("hidden", isOpen);
    iconClose?.classList.toggle("hidden", !isOpen);
  });
</script>
