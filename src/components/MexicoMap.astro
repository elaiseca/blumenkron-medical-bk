---
// Mapa esquemático (tile grid) de cobertura por estado — no es un mapa
// geográfico real, así que no depende de ningún asset con licencia externa
// (ver src/lib/mexicoStateGrid.ts). Los estados con clínicas registradas se
// marcan con un pin en un solo tono; el resto queda neutro. No representa
// nivel de cobertura, solo presencia sí/no (ver src/lib/redMedica.ts).
import {
  MEXICO_STATE_GRID,
  MEXICO_GRID_COLS,
  MEXICO_GRID_ROWS,
} from "@/lib/mexicoStateGrid";
import { estados, OTROS_ESTADOS_LABEL } from "@/lib/redMedica";

const conPresencia = new Set(
  estados
    .filter((e) => e.estado !== OTROS_ESTADOS_LABEL)
    .map((e) => e.estado),
);
const nPorEstado = new Map(estados.map((e) => [e.estado, e.n]));
---

<div
  class="mx-auto grid w-full max-w-md gap-1.5"
  style={`grid-template-columns: repeat(${MEXICO_GRID_COLS}, minmax(0, 1fr)); grid-template-rows: repeat(${MEXICO_GRID_ROWS}, minmax(0, 1fr));`}
  role="img"
  aria-label="Mapa esquemático de estados con cobertura de la red médica"
>
  {
    Object.entries(MEXICO_STATE_GRID).map(([nombre, [col, row]]) => {
      const presente = conPresencia.has(nombre);
      const n = nPorEstado.get(nombre);
      const title = presente
        ? `${nombre}: ${n} clínicas`
        : `${nombre}: sin clínicas registradas`;
      return (
        <div
          class="flex aspect-square items-center justify-center rounded-md"
          style={`grid-column: ${col + 1}; grid-row: ${row + 1};`}
        >
          <div
            title={title}
            class={
              presente
                ? "flex h-full w-full items-center justify-center rounded-md bg-teal text-white"
                : "h-full w-full rounded-md bg-white/10"
            }
          >
            {presente && <span class="text-[10px] leading-none sm:text-xs">📍</span>}
          </div>
        </div>
      );
    })
  }
</div>

<div class="mt-4 flex items-center justify-center gap-2 text-xs text-white/80">
  <span class="bg-teal flex h-4 w-4 items-center justify-center rounded-md text-[9px]">
    📍
  </span>
  Estado con cobertura
</div>
