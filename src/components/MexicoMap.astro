---
// Mapa real de México (contornos simplificados desde Natural Earth,
// dominio público — no requiere atribución, ver src/lib/mexicoStatePaths.ts)
// coloreado por presencia sí/no (un solo tono, sin escala por cantidad) y
// con un pin 📍 sobre cada estado con clínicas registradas, igual que en
// la lista de /red-medica. Datos: src/lib/redMedica.ts.
import {
  MEXICO_STATE_PATHS,
  MEXICO_STATE_CENTROIDS,
  MEXICO_VIEWBOX,
} from "@/lib/mexicoStatePaths";
import { estados, OTROS_ESTADOS_LABEL } from "@/lib/redMedica";

const conPresencia = new Set(
  estados
    .filter((e) => e.estado !== OTROS_ESTADOS_LABEL)
    .map((e) => e.estado),
);
const nPorEstado = new Map(estados.map((e) => [e.estado, e.n]));

function titleFor(nombre: string): string {
  const n = nPorEstado.get(nombre);
  return n != null ? `${nombre}: ${n} clínicas` : `${nombre}: sin clínicas registradas`;
}

// Estados con pin al final, para que el marcador quede siempre encima de
// los contornos vecinos.
const stateEntries = Object.entries(MEXICO_STATE_PATHS).sort(
  ([a], [b]) => (conPresencia.has(a) ? 1 : 0) - (conPresencia.has(b) ? 1 : 0),
);
---

<svg
  viewBox={MEXICO_VIEWBOX}
  class="mx-auto h-auto w-full max-w-md"
  role="img"
  aria-label="Mapa de estados con cobertura de la red médica"
>
  {
    stateEntries.map(([nombre, d]) => {
      const presente = conPresencia.has(nombre);
      const [cx, cy] = MEXICO_STATE_CENTROIDS[nombre] ?? [0, 0];
      return (
        <g>
          <path
            d={d}
            fill={presente ? "#4DB6BA" : "rgba(255,255,255,0.08)"}
            stroke={presente ? "#0D1B2A" : "rgba(255,255,255,0.18)"}
            stroke-width="1"
          >
            <title>{titleFor(nombre)}</title>
          </path>
          {presente && (
            <text
              x={cx}
              y={cy}
              text-anchor="middle"
              dominant-baseline="middle"
              font-size="16"
            >
              📍
            </text>
          )}
        </g>
      );
    })
  }
</svg>

<div class="mt-4 flex items-center justify-center gap-2 text-xs text-white/80">
  <span class="bg-teal flex h-4 w-4 items-center justify-center rounded-md text-[9px]">
    📍
  </span>
  Estado con cobertura
</div>
