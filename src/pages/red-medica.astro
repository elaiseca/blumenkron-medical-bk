---
export const prerender = true;

import SiteLayout from "@/layouts/SiteLayout.astro";

const categorias = [
  { icon: "🏥", name: "Clínicas y consultorios", count: "52" },
  { icon: "🧪", name: "Laboratorios clínicos", count: "25" },
  { icon: "🔬", name: "Gabinetes de diagnóstico", count: "17" },
  { icon: "🏨", name: "Hospitales", count: "14" },
  { icon: "💊", name: "Farmacias aliadas", count: "8" },
  { icon: "📹", name: "Telemedicina", count: "24/7", note: "Servicio" },
];

const estados = [
  { estado: "Ciudad de México", n: 20 },
  { estado: "Estado de México", n: 14 },
  { estado: "Jalisco", n: 11 },
  { estado: "Nuevo León", n: 10 },
  { estado: "Puebla", n: 7 },
  { estado: "Querétaro", n: 6 },
  { estado: "Yucatán", n: 5 },
  { estado: "Guanajuato", n: 5 },
  { estado: "Veracruz", n: 5 },
  { estado: "Chihuahua", n: 4 },
  { estado: "Baja California", n: 4 },
  { estado: "Otros estados", n: 25 },
];
---

<SiteLayout
  title="Red Médica — 116 clínicas en México | Medical BK by Blumenkron"
  description="Red de 116 clínicas, hospitales, laboratorios, gabinetes de diagnóstico y farmacias aliadas en la República Mexicana."
>
  <section class="bg-hero-gradient py-20 text-white">
    <div class="mx-auto max-w-4xl px-6 text-center">
      <div class="text-brand-light text-sm font-semibold uppercase tracking-widest">
        Red Médica Nacional
      </div>
      <h1 class="mt-3 text-4xl font-extrabold md:text-5xl">
        <span class="text-brand-light">116</span> clínicas participantes
      </h1>
      <p class="text-brand-light/90 mt-4 text-lg">
        Atención médica de calidad, cercana y accesible en la República
        Mexicana.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-16">
    <div class="grid gap-4 md:grid-cols-3">
      {
        categorias.map((c) => (
          <div class="shadow-card rounded-2xl border border-slate-200 bg-white p-6">
            <div class="bg-accent-gradient inline-flex h-12 w-12 items-center justify-center rounded-xl text-xl text-white">
              {c.icon}
            </div>
            <div class="mt-4 flex items-baseline gap-2">
              <span class="text-brand-blue text-3xl font-extrabold">
                {c.count}
              </span>
              <span class="text-sm text-slate-500">{c.note ?? "sedes"}</span>
            </div>
            <div class="mt-1 font-semibold">{c.name}</div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="bg-brand-soft/60 py-16">
    <div class="mx-auto max-w-7xl px-6">
      <h2 class="text-center text-3xl font-extrabold">Presencia por estado</h2>
      <div class="mt-10 grid gap-3 md:grid-cols-3 lg:grid-cols-4">
        {
          estados.map((e) => (
            <div class="flex items-center justify-between rounded-xl border border-slate-200 bg-white px-4 py-3">
              <div class="flex items-center gap-2">
                <span class="text-brand-blue">📍</span>
                <span class="text-sm font-medium">{e.estado}</span>
              </div>
              <span class="text-brand-blue rounded-full bg-brand-soft px-2.5 py-0.5 text-xs font-bold">
                {e.n}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</SiteLayout>
