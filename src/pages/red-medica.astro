---
export const prerender = true;

import SiteLayout from "@/layouts/SiteLayout.astro";
import { estados, totalClinicas, serviciosRed } from "@/lib/redMedica";
import { icon } from "@/lib/icons";

const serviciosIconos = [
  "medical-cross",
  "heart-pulse",
  "flask",
  "phone",
  "map-pin",
] as const;
---

<SiteLayout
  title={`Red Médica — ${totalClinicas} sucursales en México | Medical BK by Blumenkron`}
  description={`Red de ${totalClinicas} unidades y sucursales médicas en toda la República Mexicana.`}
>
  <section class="bg-hero-gradient py-20 text-white">
    <div class="mx-auto max-w-4xl px-6 text-center">
      <div class="text-brand-light text-sm font-semibold uppercase tracking-widest">
        Red Médica Nacional
      </div>
      <h1 class="mt-3 text-4xl font-extrabold md:text-5xl">
        <span class="text-brand-light">{totalClinicas}</span> unidades y sucursales
        médicas
      </h1>
      <p class="text-brand-light/90 mt-4 text-lg">
        Atención médica de calidad, cercana y accesible en la República
        Mexicana.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-16">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {
        serviciosRed.map((s, i) => (
          <div class="shadow-card rounded-2xl border border-slate-200 bg-white p-6">
            <div
              class="bg-accent-gradient inline-flex h-12 w-12 items-center justify-center rounded-xl text-white"
              set:html={icon(serviciosIconos[i])}
            />
            <div class="mt-4 font-semibold">{s}</div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="bg-brand-soft/60 py-16">
    <div class="mx-auto max-w-7xl px-6">
      <h2 class="text-center text-3xl font-extrabold">Presencia por estado</h2>
      <div class="mt-10 grid gap-3 md:grid-cols-3 lg:grid-cols-4">
        {
          estados.map((e) => (
            <div class="flex items-center justify-between rounded-xl border border-slate-200 bg-white px-4 py-3">
              <div class="flex items-center gap-2">
                <span class="text-brand-blue shrink-0" set:html={icon("map-pin", 16)} />
                <span class="text-sm font-medium">{e.estado}</span>
              </div>
              <span class="text-brand-blue rounded-full bg-brand-soft px-2.5 py-0.5 text-xs font-bold">
                {e.n}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</SiteLayout>
