---
export const prerender = true;

import SiteLayout from "@/layouts/SiteLayout.astro";
import { plans, planBenefits, formatMXN } from "@/lib/plans";
import { icon } from "@/lib/icons";
import { servicios } from "@/lib/services";
---

<SiteLayout
  title="Membresías Corporativo e Integral — Medical BK by Blumenkron"
  description="Membresías Corporativo e Integral, con los mismos beneficios: consultas, medicamentos, especialistas, dental, oftalmología y check-up anual."
>
  {/* HERO */}
  <section class="bg-hero-gradient py-20 text-white">
    <div class="mx-auto max-w-4xl px-6 text-center">
      <div class="text-brand-light text-sm font-semibold uppercase tracking-widest">
        Membresías Medical BK
      </div>
      <h1 class="mt-3 text-4xl font-extrabold md:text-5xl">
        Planes diseñados para cada etapa de tu vida
      </h1>
      <p class="text-brand-light/90 mt-4 text-lg">
        Elige la protección que mejor se adapta a ti y a tu familia. Sin
        sorpresas, sin letras chiquitas.
      </p>
    </div>
  </section>

  {/* CARDS */}
  <section class="mx-auto -mt-10 max-w-5xl px-6">
    <div class="grid gap-6 md:grid-cols-2">
      {
        plans.map((p) => (
          <div class="shadow-card rounded-3xl border border-slate-200 bg-white p-8">
            <h3 class="text-2xl font-extrabold">{p.name}</h3>
            <p class="mt-1 text-sm text-slate-600">{p.tagline}</p>

            {p.priceMXN != null ? (
              <>
                <div class="mt-6 flex items-baseline gap-1">
                  <span class="text-brand-blue text-4xl font-extrabold">
                    {formatMXN(p.priceMXN)}
                  </span>
                  <span class="text-sm text-slate-500">{p.period}</span>
                </div>

                {/* Placeholder de compra — T-013b lo reemplaza por el
                    checkout embebido de Stripe (MembershipCheckout, T-012) */}
                <a
                  href="/cotizador"
                  class="bg-accent-gradient shadow-brand mt-6 block w-full rounded-md py-3 text-center text-sm font-semibold text-white"
                >
                  Comprar {p.name}
                </a>
                <p class="mt-2 text-center text-xs text-slate-500">
                  Pago en línea próximamente — por ahora te conectamos con un
                  asesor. Aceptaremos tarjeta (Visa, Mastercard, American
                  Express), PayPal, transferencia SPEI y meses sin intereses.
                </p>
              </>
            ) : (
              <>
                <div class="mt-6">
                  <span class="text-brand-blue text-2xl font-extrabold">
                    Cotización personalizada
                  </span>
                  <p class="mt-1 text-sm text-slate-500">
                    Contáctanos para ofrecerte un servicio personalizado.
                  </p>
                </div>

                <a
                  href="/cotizador"
                  class="bg-accent-gradient shadow-brand mt-6 block w-full rounded-md py-3 text-center text-sm font-semibold text-white"
                >
                  Cotiza aquí
                </a>
              </>
            )}
          </div>
        ))
      }
    </div>
  </section>

  {/* COMPARATIVO */}
  <section class="mx-auto max-w-5xl px-6 py-20">
    <h2 class="text-center text-3xl font-extrabold md:text-4xl">
      Comparativo de beneficios
    </h2>
    <p class="mx-auto mt-3 max-w-2xl text-center text-sm text-slate-600">
      Corporativo e Integral incluyen exactamente los mismos beneficios — la
      diferencia es el enfoque: Corporativo para empresas y equipos de
      trabajo, Integral para ti y tu familia.
    </p>
    <div class="shadow-card mt-10 overflow-x-auto rounded-2xl border border-slate-200 bg-white">
      <table class="w-full min-w-[560px]">
        <thead>
          <tr class="bg-brand-soft">
            <th class="p-4 text-left text-sm font-semibold">Beneficio</th>
            {
              plans.map((p) => (
                <th class="p-4 text-center text-sm font-semibold">{p.name}</th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            planBenefits.map((row, i) => (
              <tr class={i % 2 ? "bg-brand-soft/40" : ""}>
                <td class="p-4 text-sm">{row.label}</td>
                <td class="p-4 text-center">
                  <span
                    class={row.corporativo ? "inline-block text-teal" : "inline-block text-slate-300"}
                    set:html={icon(row.corporativo ? "check-circle" : "x-circle", 18)}
                  />
                </td>
                <td class="p-4 text-center">
                  <span
                    class={row.integral ? "inline-block text-teal" : "inline-block text-slate-300"}
                    set:html={icon(row.integral ? "check-circle" : "x-circle", 18)}
                  />
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-6 text-center text-xs text-slate-500">
      Precio de Integral anual en pesos mexicanos, IVA no incluido.
      Corporativo se cotiza según la cantidad de empleados.
    </p>
  </section>

  {/* SERVICIOS Y COBERTURA */}
  <section class="bg-brand-soft/60 py-20">
    <div class="mx-auto max-w-4xl px-6">
      <h2 class="text-center text-3xl font-extrabold md:text-4xl">
        Descubre todo lo que incluye tu membresía
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-center text-sm text-slate-600">
        Servicio por servicio, esto es lo que cubre tu membresía Medical BK
        — igual para Corporativo e Integral.
      </p>
      <div class="mt-10 space-y-4">
        {
          servicios.map((s) => (
            <div class="shadow-card flex gap-4 rounded-2xl border border-slate-200 bg-white p-6">
              <div
                class="bg-accent-gradient inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-xl text-white"
                set:html={icon(s.icon)}
              />
              <div>
                <h3 class="font-bold">{s.servicio}</h3>
                <p class="mt-1 text-sm text-slate-600">{s.cobertura}</p>
              </div>
            </div>
          ))
        }
      </div>
      <p class="mt-6 text-center text-xs text-slate-500">
        Las cifras y servicios corresponden a la información
        proporcionada y pueden actualizarse conforme cambie la red o las
        condiciones de Medical BK.
      </p>
    </div>
  </section>
</SiteLayout>
